 			       "refresh_nft_cache", ret);
-			return -1;
+			errno = saved;
+			return -2;
 		}
 	} while(ret >= 1 /*== MNL_CB_OK*/);
 	/* ret == MNL_CB_STOP */
@@ -1379,6 +1451,10 @@ start_batch(char *buf, size_t buf_size)
