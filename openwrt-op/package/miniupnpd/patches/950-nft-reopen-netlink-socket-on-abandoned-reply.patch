+/* A dump is interrupted (NLM_F_DUMP_INTR, errno EINTR) whenever the ruleset
+ * changes while it is being read, which gets likely once the chain no longer
+ * fits in one datagram. That is transient: dump again. */
+#define NFT_DUMP_ATTEMPTS 3
+
+static int
+refresh_nft_cache_once(struct rule_list *head, const char *table, const char *chain, uint32_t family, enum rule_type type);
+
 /*
  * return -1 in case of error, 0 if OK
  */
 int
 refresh_nft_cache(struct rule_list *head, const char *table, const char *chain, uint32_t family, enum rule_type type)
+{
+	int attempt;
+	int ret = -1;
+
+	for (attempt = 1; attempt <= NFT_DUMP_ATTEMPTS; attempt++) {
+		errno = 0;
+		ret = refresh_nft_cache_once(head, table, chain, family, type);
+		if (ret == 0)
+			return 0;
+		if (ret == -2) {
+			/* the reply was abandoned half-read */
+			int intr = (errno == EINTR);
+			nft_mnl_resync("refresh_nft_cache");
+			flush_nft_cache(head);
+			if (intr)
+				continue;
+		}
+		break;
+	}
+	return -1;
+}
+
+/*
+ * return 0 if OK, -1 in case of error with the socket still in sync,
+ * -2 if the reply was not read to the end (errno is preserved)
+ */
+static int
+refresh_nft_cache_once(struct rule_list *head, const char *table, const char *chain, uint32_t family, enum rule_type type)
 {
