+/*
+ * Replace the netlink socket with a fresh one.
+ *
+ * The socket is long-lived. When a dump or a batch reply is abandoned
+ * before NLMSG_DONE / the final ACK (mnl_cb_run() error, recv error,
+ * interrupted dump...), the rest of that reply stays queued on it. Every
+ * later request then reads those stale messages first, fails the sequence
+ * check and returns early again, leaving even more behind: the daemon can
+ * no longer list, add or delete rules until it is restarted, and expired
+ * mappings pile up in the ruleset. A new socket starts with an empty
+ * receive queue. The rule caches may be out of date as well, so drop them.
+ */
+static void
+nft_mnl_resync(const char *caller)
+{
+	syslog(LOG_WARNING, "%s: netlink reply not fully read, reopening the netlink socket",
+	       caller);
+	nft_mnl_disconnect();
+	if (nft_mnl_connect() < 0) {
+		nft_mnl_disconnect();
+		syslog(LOG_ERR, "%s: could not reopen the netlink socket", caller);
+	}
+	rule_list_filter_validate = RULE_CACHE_INVALID;
+	rule_list_redirect_validate = RULE_CACHE_INVALID;
+	rule_list_peer_validate = RULE_CACHE_INVALID;
+}
+
